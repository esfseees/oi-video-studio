{
  "title": "排队接水",
  "algorithm": "贪心算法",
  "lang": "cpp",
  "theme": "day",
  "scenes": [
    {
      "kind": "intro",
      "steps": [
        { "say": "嗨，同学们好呀！欢迎来到今天的信奥小课堂。" },
        { "say": "今天我们一起来攻克一道贪心算法的经典题：排队接水！" }
      ]
    },
    {
      "kind": "stage",
      "title": "读题",
      "widgets": [
        { "id": "q", "type": "array", "label": "每个人的接水时间", "values": [5, 1, 3], "icons": ["🧒", "👧", "🧑"], "base": 1 },
        { "id": "goal", "type": "note", "text": "目标：让平均等待时间最小", "style": "big", "hidden": true }
      ],
      "steps": [
        { "say": "先来读题。有 n 个人在一个水龙头前排队接水，每个人都有自己的接水时间。", "do": [{ "w": "q", "op": "hl", "index": "all", "color": "blue" }] },
        { "say": "我们要安排一个排队顺序，让所有人的平均等待时间最小。", "do": [{ "w": "q", "op": "clear" }, { "w": "goal", "op": "show" }] }
      ]
    },
    {
      "kind": "stage",
      "title": "小实验：顺序会影响等待时间吗？",
      "widgets": [
        { "id": "n", "type": "note", "text": "排法一：5、1、3", "style": "pill" },
        { "id": "q", "type": "array", "label": "排队顺序（格子里是接水时间）", "values": [5, 1, 3], "icons": ["🧒", "👧", "🧑"], "base": 1 },
        { "id": "v", "type": "vars", "items": ["第1人等", "第2人等", "第3人等", "一共等"] }
      ],
      "steps": [
        { "say": "排法一，按 5、1、3 的顺序。第一个人不用等，第二个人要等 5 分钟。", "do": [
          { "w": "q", "op": "hl", "index": [1], "color": "green" }, { "w": "v", "op": "set", "name": "第1人等", "value": 0 },
          { "w": "q", "op": "hl", "index": [2], "color": "yellow" }, { "w": "v", "op": "set", "name": "第2人等", "value": 5 }] },
        { "say": "第三个人要等 5 加 1，等于 6 分钟。三个人一共等了 11 分钟。", "do": [
          { "w": "q", "op": "hl", "index": [3], "color": "yellow" }, { "w": "v", "op": "set", "name": "第3人等", "value": 6 }, { "w": "v", "op": "set", "name": "一共等", "value": 11 }] },
        { "say": "换一种排法，让接水快的人排到前面，变成 1、3、5。", "do": [
          { "w": "q", "op": "clear" }, { "w": "q", "op": "reorder", "values": [1, 3, 5] }, { "w": "n", "op": "text", "text": "排法二：1、3、5" }] },
        { "say": "这一次，第一个人不用等，第二个人等 1 分钟，第三个人等 1 加 3，等于 4 分钟。", "do": [
          { "w": "v", "op": "set", "name": "第1人等", "value": 0 }, { "w": "v", "op": "set", "name": "第2人等", "value": 1 }, { "w": "v", "op": "set", "name": "第3人等", "value": 4 }] },
        { "say": "一共只等了 5 分钟！所以贪心策略就是：按接水时间从小到大排序。", "do": [
          { "w": "v", "op": "set", "name": "一共等", "value": 5 }, { "w": "q", "op": "hl", "index": "all", "color": "green" }, { "w": "n", "op": "text", "text": "贪心：接水时间短的排前面" }] }
      ]
    },
    {
      "kind": "stage",
      "title": "代码：结构体和排序规则",
      "widgets": [
        { "id": "code", "type": "code" },
        { "id": "tip", "type": "note", "text": "结构体：把时间和编号绑在一起", "style": "pill" },
        { "id": "t", "type": "array", "label": "a[i].t 接水时间", "values": [3, 1, 4, 2], "base": 1 },
        { "id": "id", "type": "array", "label": "a[i].id 原来的编号", "values": [1, 2, 3, 4], "base": 1 }
      ],
      "steps": [
        { "say": "下面来看代码。先定义一个结构体，t 表示接水时间，id 表示原来的编号。", "do": [{ "w": "code", "op": "type", "lines": [1, 7] }] },
        { "say": "再写一个比较函数。时间短的排前面；时间一样，就让编号小的在前。", "do": [{ "w": "code", "op": "type", "lines": [9, 12] }, { "w": "tip", "op": "text", "text": "cmp：时间短的在前" }] },
        { "say": "主函数里，先读入 n，再读入每个人的时间，同时把编号记下来。", "do": [{ "w": "code", "op": "type", "lines": [14, 20] }, { "w": "t", "op": "hl", "index": "all", "color": "blue" }] },
        { "say": "然后调用 sort，按接水时间从小到大排好队，编号也跟着一起移动。", "do": [
          { "w": "code", "op": "type", "lines": [21, 21] }, { "w": "t", "op": "reorder", "values": [1, 2, 3, 4] }, { "w": "id", "op": "reorder", "values": [2, 4, 1, 3] }, { "w": "tip", "op": "text", "text": "排序后：编号顺序是 2 4 1 3" }] }
      ]
    },
    {
      "kind": "stage",
      "title": "代码：累加等待时间",
      "widgets": [
        { "id": "code", "type": "code" },
        { "id": "t", "type": "array", "label": "排好序的接水时间", "values": [1, 2, 3, 4], "base": 1 },
        { "id": "v", "type": "vars", "items": [{ "name": "s", "value": 0 }, { "name": "sum", "value": 0 }] },
        { "id": "io", "type": "io", "input": "4\n3 1 4 2", "output": "" }
      ],
      "steps": [
        { "say": "接下来是核心循环。s 是当前这个人要等多久，sum 是所有人等待时间的总和。", "do": [{ "w": "code", "op": "type", "lines": [23, 29] }] },
        { "say": "第一个人：先把 s 加进 sum，再让 s 加上他的接水时间 1。", "do": [
          { "w": "code", "op": "focus", "lines": [27, 28] }, { "w": "t", "op": "ptr", "name": "i", "index": 1 }, { "w": "v", "op": "set", "name": "sum", "value": 0 }, { "w": "v", "op": "set", "name": "s", "value": 1 }] },
        { "say": "第二个人：sum 变成 1，s 变成 3。", "do": [
          { "w": "t", "op": "ptr", "name": "i", "index": 2 }, { "w": "v", "op": "set", "name": "sum", "value": 1 }, { "w": "v", "op": "set", "name": "s", "value": 3 }] },
        { "say": "第三个人、第四个人也一样，最后 sum 等于 10。", "do": [
          { "w": "t", "op": "ptr", "name": "i", "index": 3 }, { "w": "v", "op": "set", "name": "sum", "value": 4 }, { "w": "v", "op": "set", "name": "s", "value": 6 },
          { "w": "t", "op": "ptr", "name": "i", "index": 4 }, { "w": "v", "op": "set", "name": "sum", "value": 10 }, { "w": "v", "op": "set", "name": "s", "value": 10 }] },
        { "say": "最后输出 sum 除以 n，保留两位小数。记得乘上 1.0，变成小数再除。", "do": [
          { "w": "code", "op": "type", "lines": [30, 33] }, { "w": "io", "op": "out", "text": "2 4 1 3\n2.50" }] }
      ]
    },
    {
      "kind": "outro",
      "title": "总结",
      "points": ["贪心策略：接水时间短的排前面", "结构体绑定时间和编号，再排序", "等待时间不包括自己，sum 用 long long"],
      "steps": [
        { "say": "总结一下：排队接水，贪心策略就是短的先来。" },
        { "say": "用结构体绑定时间和编号，排序以后再累加等待时间。" },
        { "say": "别忘了 sum 要用 long long 哦。快去动手试一试吧，拜拜！" }
      ]
    }
  ]
}
